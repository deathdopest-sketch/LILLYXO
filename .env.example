# =============================================================================
# Lilly Bot v2.0 — Environment Variables
# =============================================================================
# Copy this file:  cp .env.example .env
# Fill in YOUR values below.  Never commit .env — it's in .gitignore.
# =============================================================================

# -----------------------------------------------------------------------------
# Lilly — StumbleChat login  (REQUIRED)
# -----------------------------------------------------------------------------
# The StumbleChat account email/username and password for Lilly's account.
# If you don't have one yet: create a StumbleChat account, then set these.
LILLY_LOGIN_EMAIL=your_stumblechat_email_or_username
LILLY_LOGIN_PASS=your_stumblechat_password

# Optional: override the in-room display nick (default: Lilly)
# LILLY_BOT_NICK=Lilly

# Optional: comma-separated rooms to join (default: zombitious,meatspace)
# LILLY_ROOMS=yourroom,anotherroom

# Lilly's "home room" — the room where she has owner and can set topics/OP.
# Typically this is your own StumbleChat room name (same as your account name).
LILLY_HOME_ROOM=your_home_room_name

# -----------------------------------------------------------------------------
# ZomB — StumbleChat login  (only needed if running ZomB alongside Lilly)
# -----------------------------------------------------------------------------
ZOMB_LOGIN_EMAIL=your_zomb_stumblechat_email
ZOMB_LOGIN_PASS=your_zomb_stumblechat_password

# Optional overrides
# ZOMB_BOT_NICK=ZomB
# ZOMB_ROOMS=zombitious,room2

# -----------------------------------------------------------------------------
# YouTube API  (optional — needed for playlist search)
# -----------------------------------------------------------------------------
# Get a free API key at: https://console.developers.google.com/
# Enable "YouTube Data API v3" on the project.
# YOUTUBE_API_KEY=your_youtube_api_key
# YOUTUBE_CHANNEL_ID=your_channel_id

# -----------------------------------------------------------------------------
# Ollama AI  (optional — uses localhost:11434 by default)
# -----------------------------------------------------------------------------
# Override if Ollama runs on a different host (e.g. inside Docker).
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=dolphin3:8b
# OLLAMA_FAST_MODEL=llama3.2:1b
# OLLAMA_FALLBACK_MODEL=llama3.1:8b
# OLLAMA_VISION_MODEL=qwen2.5vl:7b

# -----------------------------------------------------------------------------
# Chrome browser path  (optional — auto-detected on most systems)
# -----------------------------------------------------------------------------
# BROWSER_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# -----------------------------------------------------------------------------
# Webcam video directory  (optional — only needed for fake webcam mode)
# -----------------------------------------------------------------------------
# WEBCAM_DIR=C:\path\to\your\webcam\videos
